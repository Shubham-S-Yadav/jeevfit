APP_NAME=JeevFit
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://jeevfit:jeevfit@localhost:5432/jeevfit
DATABASE_URL_SYNC=postgresql://jeevfit:jeevfit@localhost:5432/jeevfit

# Auth - CHANGE THIS in production: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# AI Provider: "api_key" or "vertex"
GEMINI_PROVIDER=api_key

# Option 1: API Key (when GEMINI_PROVIDER=api_key)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Option 2: Vertex AI (when GEMINI_PROVIDER=vertex)
# Requires: gcloud auth application-default login
# GEMINI_VERTEX_PROJECT=your-gcp-project-id
# GEMINI_VERTEX_LOCATION=us-central1

# Model name (works for both providers)
GEMINI_MODEL=gemini-2.5-flash

# Storage
UPLOAD_DIR=./uploads

# Redis
REDIS_URL=redis://localhost:6379/0
