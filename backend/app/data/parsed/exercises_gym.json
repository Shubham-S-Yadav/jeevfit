  "progression_principles": {
    "methods": [
      "Increase weight: Add 1-2.5 kg (upper body) or 2.5-5 kg (lower body) when you can complete all prescribed reps with good form",
      "Increase reps: If prescribed 3x8-12, once you hit 3x12, increase weight and drop back to 3x8",
      "Increase sets: Add 1 set per exercise over time (up to 10-20 sets per muscle group per week)",
      "Increase frequency: Train each muscle group 2-3x/week rather than 1x",
      "Decrease rest time: More metabolic stress; use cautiously",
      "Improve form/ROM: Better muscle activation, deeper stretch",
      "Tempo manipulation: Slow eccentrics (3-4 sec lowering) increase time under tension"
    ],
    "hypertrophy_rep_ranges": {
      "strength": { "reps": "1-5", "rest": "3-5 min", "primary_stimulus": "Neural adaptations" },
      "hypertrophy": { "reps": "6-12", "rest": "1.5-3 min", "primary_stimulus": "Mechanical tension + metabolic stress" },
      "endurance": { "reps": "12-20+", "rest": "30-90 sec", "primary_stimulus": "Muscular endurance + hypertrophy if close to failure" }
    },
    "volume_landmarks_per_muscle_per_week": {
      "minimum_effective": "6-8 sets (maintains muscle)",
      "moderate": "10-15 sets (good growth for most)",
      "maximum_recoverable": "15-25 sets (upper limit before recovery suffers)",
